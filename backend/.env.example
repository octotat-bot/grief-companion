# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# MongoDB Atlas connection string
# Get this from: Atlas dashboard → Connect → Drivers → Node.js
# Make sure grief_companion is the database name at the end
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/grief_companion?retryWrites=true&w=majority&appName=AppName

# Gemini API key — free at aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Python RAG microservice URL
RAG_URL=http://localhost:5001

# Server port
PORT=3001

# Environment
NODE_ENV=development
